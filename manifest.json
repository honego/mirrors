{
  "site": {
    "title": "Honeok Mirrors 🐇",
    "baseUrl": "https://mirrors.honeok.com",
    "repository": "https://github.com/honeokX/mirrors"
  },
  "defaults": {
    "checksum": true
  },
  "items": [
    {
      "name": "acme.sh",
      "source": "https://github.com/acmesh-official/acme.sh",
      "path": "acme.sh",
      "isRepository": true
    },
    {
      "name": "install.sh",
      "source": "https://get.docker.com",
      "path": "docker/install.sh",
      "isRepository": false
    },
    {
      "name": "gradlew",
      "source": [
        "https://github.com/gradle/gradle/raw/master/gradlew",
        "https://github.com/gradle/gradle/raw/master/gradlew.bat"
      ],
      "path": ["gradle/gradlew", "gradle/gradlew.bat"],
      "isRepository": false
    },
    {
      "name": "maven",
      "source": [
        "https://github.com/apache/maven-wrapper/raw/master/maven-wrapper-distribution/src/resources/mvnw",
        "https://github.com/apache/maven-wrapper/raw/master/maven-wrapper-distribution/src/resources/mvnw.cmd"
      ],
      "path": ["maven/mvnw", "maven/mvnw.cmd"],
      "isRepository": false
    }
  ]
}
